// [a17-fingerprint-deferred] The HIDL 2.3 fingerprint wrapper service is excluded on the
// [a17-fingerprint-deferred] A17 line: the platform removed the
// [a17-fingerprint-deferred] android.hardware.biometrics.fingerprint@2.x HIDL libs it linked
// [a17-fingerprint-deferred] (see roms/docs/2026-11-05-los24-line-switch-plan.md D9). The
// [a17-fingerprint-deferred] excluded module was:
// [a17-fingerprint-deferred]   cc_binary "android.hardware.biometrics.fingerprint@2.3-service.x2"
// [a17-fingerprint-deferred]   (srcs: service.cpp, BiometricsFingerprint.cpp; shared_libs:
// [a17-fingerprint-deferred]    libbase libhidlbase liblog libutils
// [a17-fingerprint-deferred]    android.hardware.biometrics.fingerprint@2.1/2.2/2.3
// [a17-fingerprint-deferred]    vendor.oplus.hardware.biometrics.fingerprint@2.1)
// libudfps_extension.x2 stays: surfaceflinger consumes it via the udfps soong config.

cc_library_static {
    name: "libudfps_extension.x2",
    srcs: ["UdfpsExtension.cpp"],
    include_dirs: [
        "frameworks/native/services/surfaceflinger/CompositionEngine/include"
    ],
    header_libs: [
        "generated_kernel_headers",
    ],
}
